<h1 class="text-2xl font-bold mb-4">Wszystkie filmy</h1>

<% if @movies.any? %>
  <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
    <% @movies.each do |movie| %>
      <div class="bg-white p-4 rounded shadow">
        <h2 class="text-xl font-semibold">
          <%= link_to movie.title, movie, class: "text-blue-600 hover:underline" %>
        </h2>
        <p class="text-sm text-gray-600">Reżyser: <%= movie.director %></p>
        <p class="text-sm text-gray-600">Premiera: <%= movie.release_date %></p>
        <p class="mt-2 font-medium">⭐ <%= movie.average_rating %></p>
      </div>
    <% end %>
  </div>
<% else %>
  <p class="text-gray-600">Brak filmów. <%= link_to "Dodaj pierwszy film", new_movie_path, class: "text-blue-600 underline" %>.</p>
<% end %>