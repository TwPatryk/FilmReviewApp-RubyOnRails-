<!DOCTYPE html>
<html>
  <head>
    <title>FilmReview</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= stylesheet_link_tag "tailwind", "data-turbo-track": "reload" %>
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-gray-100 text-gray-900">
    <nav class="bg-gray-800 text-white p-4 mb-6">
      <div class="max-w-4xl mx-auto flex justify-between items-center">
        <%= link_to "🎬 FilmReview", root_path, class: "font-bold text-lg" %>
        <div class="space-x-4">
          <%= link_to "Filmy", movies_path %>
          <% if user_signed_in? %>
            <span>Witaj, <%= current_user.email %></span>
            <%= link_to "Dodaj film", new_movie_path %>
            <%= link_to "Wyloguj", destroy_user_session_path, data: { turbo_method: :delete } %>
          <% else %>
            <%= link_to "Zaloguj", new_user_session_path %>
            <%= link_to "Rejestracja", new_user_registration_path %>
          <% end %>
        </div>
      </div>
    </nav>

    <main class="max-w-4xl mx-auto px-4">
      <% if notice %>
        <p class="bg-green-100 text-green-800 p-3 rounded mb-4"><%= notice %></p>
      <% end %>
      <% if alert %>
        <p class="bg-red-100 text-red-800 p-3 rounded mb-4"><%= alert %></p>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>